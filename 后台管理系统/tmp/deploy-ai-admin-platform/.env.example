NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_admin_platform?schema=public
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
ENCRYPTION_SECRET=change-this-32-byte-secret-key
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8080,http://localhost:8080
ADMIN_INITIAL_PHONE=13800000000
ADMIN_INITIAL_PASSWORD=admin123456
GENERATION_MOCK_MODE=true
UPSTREAM_TIMEOUT_MS=120000
GENERATION_RECONCILE_ENABLED=true
GENERATION_RECONCILE_INTERVAL_MS=60000
GENERATION_STALE_TASK_MINUTES=10
PAYMENT_MODE=mock
RECHARGE_CREDITS_PER_CNY=100
ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# Optional: load only OBJECT_STORAGE_* keys from another local env file.
OBJECT_STORAGE_ENV_FILE=
OBJECT_STORAGE_PROVIDER=cos
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=mjb-reference
OBJECT_STORAGE_MAX_BYTES=20971520
OBJECT_STORAGE_FORCE_PATH_STYLE=false
