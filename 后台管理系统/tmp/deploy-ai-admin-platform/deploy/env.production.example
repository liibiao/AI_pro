NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://ai_admin:replace-password@127.0.0.1:5432/ai_admin_platform?schema=public
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d
ENCRYPTION_SECRET=replace-with-long-random-secret
CORS_ORIGIN=https://your-domain.com
GENERATION_MOCK_MODE=false
UPSTREAM_TIMEOUT_MS=120000
GENERATION_RECONCILE_ENABLED=true
GENERATION_RECONCILE_INTERVAL_MS=60000
GENERATION_STALE_TASK_MINUTES=10
PAYMENT_MODE=voucher
RECHARGE_CREDITS_PER_CNY=100

ADMIN_INITIAL_PHONE=
ADMIN_INITIAL_PASSWORD=

ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/pay/alipay/notify

OBJECT_STORAGE_PROVIDER=cos
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=mjb-reference
OBJECT_STORAGE_MAX_BYTES=20971520
OBJECT_STORAGE_FORCE_PATH_STYLE=false
