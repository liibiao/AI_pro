#!/usr/bin/env bash
set -euo pipefail

src="${@: -2:1}"
dest="${@: -1}"

if [[ "$src" == *.tar.gz ]]; then
  echo "[scp-wrapper] archive already uploaded: $dest"
  exit 0
fi

if [[ "$(basename "$src")" == apply-*.sh ]]; then
  echo "[scp-wrapper] apply script already uploaded: $dest"
  exit 0
fi

if [[ "$dest" != *:* ]]; then
  exec /usr/bin/scp "$@"
fi

host="${dest%%:*}"
remote="${dest#*:}"
echo "[scp-wrapper] upload script via ssh cat: $remote"
exec /usr/bin/ssh \
  -o StrictHostKeyChecking=accept-new \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=4 \
  "$host" "cat > '$remote' && chmod 700 '$remote'" < "$src"
