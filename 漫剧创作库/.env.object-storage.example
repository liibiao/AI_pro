# 漫剧创作库对象存储配置模板
# 使用前复制为 .env 或写入你的 shell 环境变量。
# 注意：不要把真实密钥提交到代码仓库。

# 可选：r2 / cos / oss / s3
OBJECT_STORAGE_PROVIDER="r2"

# Cloudflare R2 示例：
# OBJECT_STORAGE_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
# OBJECT_STORAGE_REGION="auto"
# OBJECT_STORAGE_BUCKET="你的bucket名"
# OBJECT_STORAGE_PUBLIC_BASE_URL="https://你的R2公网域名"

# 腾讯云 COS 示例：
# OBJECT_STORAGE_PROVIDER="cos"
# OBJECT_STORAGE_ENDPOINT_URL="https://cos.ap-guangzhou.myqcloud.com"
# OBJECT_STORAGE_REGION="ap-guangzhou"
# OBJECT_STORAGE_BUCKET="你的bucket名"
# OBJECT_STORAGE_PUBLIC_BASE_URL="https://你的COS公网域名"

# 阿里 OSS 示例：
# OBJECT_STORAGE_PROVIDER="oss"
# OBJECT_STORAGE_ENDPOINT_URL="https://oss-cn-hangzhou.aliyuncs.com"
# OBJECT_STORAGE_BUCKET="你的bucket名"
# OBJECT_STORAGE_PUBLIC_BASE_URL="https://你的OSS公网域名"

OBJECT_STORAGE_ACCESS_KEY_ID="你的 AccessKeyId / SecretId"
OBJECT_STORAGE_SECRET_ACCESS_KEY="你的 SecretAccessKey / SecretKey"
OBJECT_STORAGE_PREFIX="mjb-reference"
OBJECT_STORAGE_MAX_BYTES="20971520"

# R2 通常不需要 ACL；COS/OSS 若桶策略已公开读，也不需要。
# 如确实需要 S3 ACL，可开启：
# OBJECT_STORAGE_ACL="public-read"
